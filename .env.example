# Copy this file to .env and adjust as needed. All settings have sane
# defaults (see src/studymate/config/settings.py) - .env is optional.

# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads
# PROCESSED_DIR=./data/processed
# VECTOR_DIR=./data/vectors
# DATABASE_PATH=./data/studymate.db

# EMBEDDING_MODEL=hashing-384
# Set to a real model name to use sentence-transformers instead, e.g.:
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434

# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# TOP_K=5
# OCR_ENABLED=true
# MAX_UPLOAD_MB=50
